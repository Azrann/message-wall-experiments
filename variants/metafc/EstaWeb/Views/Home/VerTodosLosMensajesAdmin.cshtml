@model List<EstaWebSeAutodestruira.Message>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Admin</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <script src="//netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>
    <!------ Include the above in your HEAD tag ---------->
</head>
<body>
<div>
    <div class="container">
        @foreach (var item in Model) {
            <div class="row" id="@item.Id">
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="well well-sm">
                        @item.Date
                    </div>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6">
                    <div class="well well-sm">
                        @item.Text
                    </div>
                </div>
                <div class="col-xs-1 col-sm-1 col-md-1">
                    <div class="well well-sm">
                        @item.Likes
                    </div>
                </div>
                <div class="col-xs-2 col-sm-2 col-md-2">
                        <button class="btn btn-danger" attr-id="@item.Id">Delete</button>
                </div>
            </div>
        }
    </div>
    <script>
        $(document).ready(function() {
            $(".btn").click(function() {
               // alert("/DeleteMensaje/" + $(this).attr('attr-id') + "/supersecretkey321");
                $.post("/DeleteMensaje/" + $(this).attr('attr-id') + "/supersecretkey321");
               $(this).parent().parent().remove();
            });
        });
    </script>
</div>
</body>
</html>